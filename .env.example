# Copy to .env.local and fill real values before live TTS or deploy.

OPENAI_API_KEY=

# At least 32 bytes of high-entropy secret material. Used only to authenticate
# exact content and narration approval evidence; never serialize or commit it.
BEBEBONJOUR_APPROVAL_HMAC_KEY=

# Vercel personal token or team-scoped token used by `announce deploy`.
VERCEL_TOKEN=

# Optional, but recommended when this repo is not already linked with `vercel link`.
# If both are set, the CLI will create `.vercel/project.json` automatically.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Notion-free fulfillment ingress. Keep every secret server-side in the
# dedicated Vercel project; never expose the service-role key to a browser.
FULFILLMENT_PRICE_MINOR=3900
FULFILLMENT_CURRENCY=EUR
TALLY_FORM_ID=

# JSON object mapping stable `question_*` and option IDs from a synthetic
# Tally test webhook. Never map production fields by their mutable labels.
TALLY_FIELD_MAP_JSON=

TALLY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hosted first-party TEST-A API. These values belong to the Vercel API runtime;
# use a Stripe test key only. CUSTOMER_FLOW_BACKEND_TOKEN must also be set in
# the isolated Convex TEST-A deployment and must never reach browser code.
CONVEX_URL=
CUSTOMER_FLOW_BACKEND_TOKEN=
CUSTOMER_FLOW_TOKEN_ENCRYPTION_KEY=
CUSTOMER_FLOW_TEST_ACCESS_TOKEN=
CUSTOMER_FLOW_ALLOWED_ORIGINS=["https://www.bebebonjour.com"]
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_FLOW_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=https://www.bebebonjour.com/suivi?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://www.bebebonjour.com/suivi?checkout=cancel

# Operator delivery runtime only; do not install these in the public Vercel API
# runtime. TEST-A sends only after persisted human approval and publication.
RESEND_API_KEY=
RESEND_FROM=Bébé Bonjour <onboarding@resend.dev>
