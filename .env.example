# Copy to .env.local and fill real values before live TTS or deploy.

OPENAI_API_KEY=

# Vercel personal token or team-scoped token used by `announce deploy`.
VERCEL_TOKEN=

# Optional, but recommended when this repo is not already linked with `vercel link`.
# If both are set, the CLI will create `.vercel/project.json` automatically.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Notion-free fulfillment ingress. Keep every secret server-side in the
# dedicated Vercel project; never expose the service-role key to a browser.
FULFILLMENT_PRICE_MINOR=3900
FULFILLMENT_CURRENCY=EUR
TALLY_FORM_ID=

# JSON object mapping stable `question_*` and option IDs from a synthetic
# Tally test webhook. Never map production fields by their mutable labels.
TALLY_FIELD_MAP_JSON=

TALLY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
