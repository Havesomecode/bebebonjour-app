# Copy to .env.local and fill real values only for the runtime you operate.

OPENAI_API_KEY=

# At least 32 bytes of high-entropy secret material. The private TEST-A operator
# is status/review-only and uses this only to authenticate exact approval evidence.
BEBEBONJOUR_APPROVAL_HMAC_KEY=

# Vercel deployment credentials for announcement publication commands.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Canonical Convex customer-flow runtime. Keep every value server-side.
CONVEX_URL=
CUSTOMER_FLOW_BACKEND_TOKEN=
CUSTOMER_FLOW_TOKEN_ENCRYPTION_KEY=
CUSTOMER_FLOW_TEST_ACCESS_TOKEN=
CUSTOMER_FLOW_ALLOWED_ORIGINS=["https://www.bebebonjour.com"]

# Stripe remains test-mode until a separately verified live-payment rollout.
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_FLOW_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=https://www.bebebonjour.com/suivi?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://www.bebebonjour.com/suivi?checkout=cancel

# Tally is intake-only: no Tally payment block and no payment fields in this map.
# Map stable question/option IDs from the exact live form after adding required
# consent. The signed webhook target is /api/webhooks/tally.
TALLY_INTAKE_FORM_ID=
TALLY_INTAKE_FIELD_MAP=
TALLY_INTAKE_SIGNING_SECRET=
