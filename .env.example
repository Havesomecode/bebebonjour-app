# Copy to .env.local and fill real values only for the runtime you operate.

OPENAI_API_KEY=

# At least 32 bytes of high-entropy secret material. The private TEST-A operator
# is status/review-only and uses this only to authenticate exact approval evidence.
BEBEBONJOUR_APPROVAL_HMAC_KEY=

# Vercel deployment credentials for announcement publication commands.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Canonical Convex customer-flow runtime. Keep every value server-side.
CONVEX_URL=
CUSTOMER_FLOW_BACKEND_TOKEN=
CUSTOMER_FLOW_TOKEN_ENCRYPTION_KEY=
CUSTOMER_FLOW_TEST_ACCESS_TOKEN=
CUSTOMER_FLOW_ALLOWED_ORIGINS=["https://www.bebebonjour.com"]

# Private Operations control plane in the fulfillment project.
BEBEBONJOUR_OPERATIONS_TOKEN=
BEBEBONJOUR_OPS_RATE_LIMIT_TOKEN=

# Isolated bebebonjour-generation-worker Vercel project only. Never co-mount
# these with CUSTOMER_FLOW_BACKEND_TOKEN or any payment/email/provider secret.
BEBEBONJOUR_OPERATIONS_WORKER_TOKEN=
BEBEBONJOUR_OPERATIONS_WORKER_ID=
BEBEBONJOUR_OPERATIONS_WORKER_ACTIONS=generate
BEBEBONJOUR_OPERATIONS_WORKER_LIMIT=5
BEBEBONJOUR_OPERATIONS_WORKER_LEASE_MS=120000
# Generation uses invocation-local /tmp staging and persists approvals, metadata,
# and private artifact bytes to the canonical Convex deployment/file storage.
# Private readback uses the claim-authenticated Convex HTTP action; no direct
# storage URL is exposed. Each file is limited to 20 MiB.
# Vercel Cron bearer credential; distinct from every Convex credential.
CRON_SECRET=

# Stripe remains test-mode until a separately verified live-payment rollout.
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_FLOW_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=https://www.bebebonjour.com/suivi?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://www.bebebonjour.com/suivi?checkout=cancel

# Tally is intake-only: no Tally payment block and no payment fields in this map.
# Map stable question/option IDs from the exact live form after adding required
# consent. The signed webhook target is /api/webhooks/tally.
TALLY_INTAKE_FORM_ID=
TALLY_INTAKE_FIELD_MAP=
TALLY_INTAKE_SIGNING_SECRET=

# Supervised paid Route A. Disabled until the candidate, exact terms, export/
# retention successor and action-specific sale/release authorization are ready.
# These values belong only to the current delivery-loop Convex deployment.
# Do not mount them into generation-only or legacy TEST-A operators.
BEBEBONJOUR_PAID_ROUTE_A_ENABLED=false
BEBEBONJOUR_PAID_DATA_AUTOMATION_ENABLED=false
# Owner1038 controlled five-use EUR1 tests only; exact contract/capability gap and
# shutdown steps: docs/paid-test-promotion.md. No automatic checkout or key expansion.
BEBEBONJOUR_PAID_TEST_PROMO_ENABLED=false
BEBEBONJOUR_PAID_TEST_PROMO_JSON=
BEBEBONJOUR_PAID_TERMS_URL=
BEBEBONJOUR_PAID_EDITORIAL_TOKEN=
BEBEBONJOUR_PAID_STRIPE_ACCOUNT_ID=
# Dedicated signed payment_intent.succeeded endpoint secret; never reuse TEST-A.
BEBEBONJOUR_PAID_STRIPE_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY above may be an existing restricted rk_live_/rk_test_ read
# credential with Account and PaymentIntent/latest-charge inspection permission.
# Do not broaden permissions or provision a new key just for reconciliation.
# Editorial token must be distinct from the generation/delivery worker token.
# The paid supervisor performs read-only Stripe PaymentIntent reconciliation;
# no payment is ever initiated by this candidate. Test evidence stays test-only.
