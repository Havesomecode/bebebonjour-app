{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bebebonjour.local/schemas/narration-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pageId",
    "revisionId",
    "provider",
    "model",
    "languages",
    "sectionOrder",
    "segments"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "pageId": { "type": "string", "minLength": 1 },
    "revisionId": { "type": "string", "pattern": "^r[1-9][0-9]*$" },
    "provider": { "const": "openai" },
    "model": { "const": "gpt-4o-mini-tts" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["ar", "fr"] }
    },
    "sectionOrder": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["intro", "dua", "meaning", "reveal", "verses", "closing"] }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "section", "ordinal", "voice", "instructions", "text"],
        "properties": {
          "language": { "enum": ["ar", "fr"] },
          "section": { "enum": ["intro", "dua", "meaning", "reveal", "verses", "closing"] },
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 6 },
          "voice": { "type": "string", "minLength": 1, "maxLength": 64 },
          "instructions": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "text": { "type": "string", "minLength": 1, "maxLength": 8192 }
        }
      }
    }
  }
}
