{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bebebonjour.local/schemas/narration-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "state",
    "pageId",
    "revision",
    "buildId",
    "contentApprovalDigest",
    "preparedBundleDigest",
    "generatedAt",
    "languages",
    "results",
    "mediaDigest",
    "generation",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "state": {
      "enum": [
        "narration_review_required",
        "narration_generation_failed"
      ]
    },
    "pageId": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^r[0-9]+$" },
    "buildId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "contentApprovalDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preparedBundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["ar", "fr"] }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "status", "files"],
            "properties": {
              "language": { "enum": ["ar", "fr"] },
              "status": { "const": "ok" },
              "files": { "type": "integer", "minimum": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "status", "error"],
            "properties": {
              "language": { "enum": ["ar", "fr"] },
              "status": { "const": "failed" },
              "error": {
                "enum": ["provider_request_failed", "media_not_decodable", "generation_failed"]
              }
            }
          }
        ]
      }
    },
    "mediaDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "voiceByLanguage"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "voiceByLanguage": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "ar": { "type": "string", "minLength": 1 },
            "fr": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "transcript"],
      "properties": {
        "root": { "const": "artifacts" },
        "transcript": { "const": "artifacts/transcript.json" }
      }
    }
  }
}
