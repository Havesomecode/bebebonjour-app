{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bebebonjour.local/schemas/narration-manifest.schema.json",
  "type": "object",
  "required": [
    "language",
    "provider",
    "model",
    "voice",
    "generatedAt",
    "files"
  ],
  "properties": {
    "language": {
      "enum": [
        "ar",
        "fr"
      ]
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "voice": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array"
    }
  }
}
