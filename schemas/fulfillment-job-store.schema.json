{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bebebonjour.local/schemas/fulfillment-job-store.schema.json",
  "title": "Bébé Bonjour TEST-A fulfillment job store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "jobs"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "authority": { "const": "local-test-only" },
    "jobs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^r[1-9][0-9]*$"
    },
    "nullable_revision_id": {
      "oneOf": [
        { "$ref": "#/$defs/revision_id" },
        { "type": "null" }
      ]
    },
    "stage": {
      "enum": ["prepare_review", "render_approved", "generate_tts", "publish", "deliver"]
    },
    "state": {
      "enum": [
        "awaiting_payment",
        "generation_queued",
        "generating",
        "content_review_required",
        "render_queued",
        "rendering",
        "tts_queued",
        "tts_generating",
        "narration_review_required",
        "publish_ready",
        "publishing",
        "published",
        "delivery_queued",
        "sending",
        "sent",
        "retry_wait",
        "failed",
        "rejected",
        "complete"
      ]
    },
    "payment_correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "product", "environment", "job_id", "intake_digest"],
      "properties": {
        "project": { "const": "bebebonjour" },
        "product": { "type": "string", "minLength": 1 },
        "environment": { "const": "test" },
        "job_id": { "type": "string", "minLength": 1 },
        "intake_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_event_id", "provider_payment_id", "correlation", "recorded_at"],
      "properties": {
        "provider_event_id": { "type": "string", "minLength": 1 },
        "provider_payment_id": { "type": "string", "minLength": 1 },
        "correlation": { "$ref": "#/$defs/payment_correlation" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "ordinal", "input_digest"],
      "properties": {
        "revision_id": { "$ref": "#/$defs/revision_id" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "input_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_digest", "transcript_digest", "asset_manifest_digest"],
      "properties": {
        "page_digest": { "$ref": "#/$defs/digest" },
        "transcript_digest": { "$ref": "#/$defs/digest" },
        "asset_manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "storage_id"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0 },
        "storage_id": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_set_id",
        "kind",
        "revision_id",
        "page_digest",
        "transcript_digest",
        "asset_manifest_digest"
      ],
      "properties": {
        "artifact_set_id": { "type": "string", "pattern": "^artifacts_[a-f0-9]{24}$" },
        "kind": { "enum": ["private_review", "prepared_bundle", "narration_review"] },
        "revision_id": { "$ref": "#/$defs/revision_id" },
        "page_digest": { "$ref": "#/$defs/digest" },
        "transcript_digest": { "$ref": "#/$defs/digest" },
        "asset_manifest_digest": { "$ref": "#/$defs/digest" },
        "manifest_ref": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_file" }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "competencies"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "competencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "review_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision_type",
        "revision_id",
        "outcome",
        "policy_version",
        "rubric_version",
        "reviewer",
        "decided_at",
        "artifact_digests",
        "reasons"
      ],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^review_[a-f0-9]{24}$" },
        "decision_type": { "enum": ["content", "narration"] },
        "revision_id": { "$ref": "#/$defs/revision_id" },
        "outcome": { "enum": ["approved", "request_changes", "rejected"] },
        "policy_version": { "const": "bebebonjour-editorial-v1" },
        "rubric_version": { "type": "string", "minLength": 1 },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "decided_at": { "type": "string", "format": "date-time" },
        "artifact_digests": { "$ref": "#/$defs/artifact_digests" },
        "reasons": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retryable", "reason_code"],
      "properties": {
        "retryable": { "type": "boolean" },
        "reason_code": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }
      }
    },
    "operation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "target_digest"],
      "properties": {
        "target_ref": { "type": "string", "minLength": 1 },
        "target_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "stage_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "stage",
        "revision_id",
        "attempt_number",
        "operation_number",
        "idempotency_key",
        "operation_binding",
        "status",
        "lease_token",
        "lease_expires_at",
        "started_at",
        "completed_at",
        "failure"
      ],
      "properties": {
        "attempt_id": { "type": "string", "pattern": "^attempt_[a-f0-9]{24}$" },
        "stage": { "$ref": "#/$defs/stage" },
        "revision_id": { "$ref": "#/$defs/nullable_revision_id" },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "operation_number": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "pattern": "^bb_[a-f0-9]{64}$" },
        "operation_binding": {
          "oneOf": [
            { "$ref": "#/$defs/operation_binding" },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["running", "completed", "retry_wait", "failed"] },
        "lease_token": { "type": ["string", "null"] },
        "lease_expires_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "failure": {
          "oneOf": [
            { "$ref": "#/$defs/failure" },
            { "type": "null" }
          ]
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "revision_id",
        "stable_url",
        "artifact_manifest_digest",
        "provider_receipt_id",
        "idempotency_key",
        "status"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "revision_id": { "$ref": "#/$defs/revision_id" },
        "stable_url": { "type": "string", "minLength": 1 },
        "artifact_manifest_digest": { "$ref": "#/$defs/digest" },
        "provider_receipt_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "pattern": "^bb_[a-f0-9]{64}$" },
        "status": { "const": "published" }
      }
    },
    "delivery_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "revision_id",
        "provider_message_id",
        "idempotency_key",
        "target_ref",
        "status",
        "delivered_at",
        "last_outcome"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "revision_id": { "$ref": "#/$defs/revision_id" },
        "provider_message_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "pattern": "^bb_[a-f0-9]{64}$" },
        "target_ref": { "type": "string", "minLength": 1 },
        "status": { "enum": ["sent", "delivered"] },
        "delivered_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "last_outcome": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome", "recorded_at", "retryable", "reason_code"],
              "properties": {
                "outcome": { "enum": ["pending", "delivered", "failed"] },
                "recorded_at": { "type": "string", "format": "date-time" },
                "retryable": { "type": "boolean" },
                "reason_code": {
                  "oneOf": [
                    { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
                    { "type": "null" }
                  ]
                }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "command_id", "command_digest", "type", "at", "state"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^event_[a-f0-9]{24}$" },
        "command_id": { "type": "string", "minLength": 1 },
        "command_digest": { "$ref": "#/$defs/digest" },
        "type": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" },
        "state": { "$ref": "#/$defs/state" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "available_at"],
      "properties": {
        "stage": { "$ref": "#/$defs/stage" },
        "available_at": { "type": "string", "format": "date-time" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority",
        "job_id",
        "environment",
        "product",
        "intake_digest",
        "payment_correlation",
        "narration_required",
        "state",
        "version",
        "created_at",
        "updated_at",
        "current_revision_id",
        "published_revision_id",
        "retry",
        "payment",
        "revisions",
        "artifact_sets",
        "review_decisions",
        "stage_attempts",
        "publication",
        "delivery_attempts",
        "events"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "authority": { "const": "convex-target/local-test-projection" },
        "job_id": { "type": "string", "minLength": 1 },
        "environment": { "const": "test" },
        "product": { "type": "string", "minLength": 1 },
        "intake_digest": { "$ref": "#/$defs/digest" },
        "payment_correlation": { "$ref": "#/$defs/payment_correlation" },
        "narration_required": { "type": "boolean" },
        "state": { "$ref": "#/$defs/state" },
        "version": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "current_revision_id": { "$ref": "#/$defs/nullable_revision_id" },
        "published_revision_id": { "$ref": "#/$defs/nullable_revision_id" },
        "retry": {
          "oneOf": [
            { "$ref": "#/$defs/retry" },
            { "type": "null" }
          ]
        },
        "payment": {
          "oneOf": [
            { "$ref": "#/$defs/payment" },
            { "type": "null" }
          ]
        },
        "revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/revision" }
        },
        "artifact_sets": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_set" }
        },
        "review_decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/review_decision" }
        },
        "stage_attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/stage_attempt" }
        },
        "publication": {
          "oneOf": [
            { "$ref": "#/$defs/publication" },
            { "type": "null" }
          ]
        },
        "delivery_attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/delivery_attempt" }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event" }
        }
      }
    }
  }
}
