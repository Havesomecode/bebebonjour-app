{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "builds": [
    {
      "src": "generation-worker/api/worker.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          ".codex-runtime/manifest.json",
          ".codex-runtime/codex.gz",
          "data/reference-catalog.json",
          "template/runtime/app.js",
          "template/runtime/phrase-progress.mjs",
          "template/runtime/styles.css",
          "template/assets/og-image.svg"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/operations/worker",
      "dest": "generation-worker/api/worker.mjs"
    }
  ],
  "crons": []
}
