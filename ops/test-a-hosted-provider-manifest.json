{
  "schemaVersion": "2.0",
  "candidateMode": "test-only",
  "candidate": {
    "appRepository": "git@github.com:Havesomecode/bebebonjour-app.git",
    "landingRepository": "git@github.com:Havesomecode/bebebonjour-landing.git",
    "canonicalHostedOrigin": "https://bebebonjour-fulfillment.vercel.app",
    "canonicalHostedApiBaseUrl": "https://bebebonjour-fulfillment.vercel.app/api/customer-flow",
    "landingOrigin": "https://www.bebebonjour.com",
    "bindingEvidence": [
      "signedAppCommit",
      "signedLandingCommit"
    ]
  },
  "authorities": {
    "intake": "signed Tally FORM_RESPONSE for the exact intake-only form; no Tally payment fields",
    "payment": "signed Stripe checkout.session.completed with livemode=false, amount_total=3900, currency=eur",
    "durableOperations": "Convex customerFlowJobs plus customerFlowWorkItems plus fulfillmentJobs",
    "publication": "operator-approved Vercel release only",
    "delivery": "operator-approved Resend send only after the persisted fulfillment gate"
  },
  "operations": [
    {
      "id": "freeze-signed-candidates",
      "provider": "git",
      "action": "verify signed app and landing commits and exact path allowlists",
      "requiredEvidence": [
        "signedAppCommit",
        "signedLandingCommit",
        "appAllowlist",
        "landingAllowlist"
      ]
    },
    {
      "id": "select-convex-production",
      "provider": "convex",
      "action": "select only the canonical havesomecode/bebebonjour-test-a production deployment",
      "requiredEvidence": [
        "teamSlug",
        "projectSlug",
        "deploymentReference",
        "deploymentName",
        "deploymentUrl",
        "readAt"
      ]
    },
    {
      "id": "install-convex-backend-token",
      "provider": "convex",
      "action": "install CUSTOMER_FLOW_BACKEND_TOKEN through the Convex secret store without command-line or transcript exposure",
      "requiredEvidence": [
        "variableName",
        "secretStore",
        "updatedAt",
        "redactedValuePresent"
      ]
    },
    {
      "id": "deploy-convex-functions",
      "provider": "convex",
      "action": "deploy the signed app candidate functions to the exact canonical production deployment after the backend token update",
      "requiredEvidence": [
        "signedAppCommit",
        "deploymentName",
        "deploymentUrl",
        "deployedAt",
        "backendTokenUpdatedAt"
      ]
    },
    {
      "id": "install-vercel-bootstrap-environment",
      "provider": "vercel",
      "action": "install exactly secretStores.vercelProduction.allowed in production scope, using an unrecorded generated high-entropy bootstrap value for STRIPE_CUSTOMER_FLOW_WEBHOOK_SECRET",
      "requiredEvidence": [
        "projectId",
        "environment",
        "variableInventory",
        "updatedAt",
        "bootstrapSecretPresent",
        "forbiddenVariablesAbsent"
      ]
    },
    {
      "id": "deploy-vercel-bootstrap-candidate",
      "provider": "vercel",
      "action": "deploy the exact signed app candidate to an immutable URL without moving the canonical alias",
      "requiredEvidence": [
        "signedAppCommit",
        "projectId",
        "bootstrapDeploymentId",
        "bootstrapDeploymentUrl",
        "readyAt",
        "bootstrapEnvironmentUpdatedAt"
      ]
    },
    {
      "id": "create-stripe-test-webhook",
      "provider": "stripe",
      "action": "create one enabled endpoint targeting the bootstrap deployment URL, then capture its signing secret without transcript exposure",
      "requiredEvidence": [
        "accountId",
        "endpointId",
        "bootstrapEndpointUrl",
        "events",
        "livemodeFalse",
        "createdAt",
        "signingSecretCaptured"
      ]
    },
    {
      "id": "install-stripe-webhook-secret",
      "provider": "vercel",
      "action": "replace only the bootstrap webhook value with the captured Stripe endpoint signing secret",
      "requiredEvidence": [
        "projectId",
        "environment",
        "variableName",
        "updatedAt",
        "bootstrapSecretReplaced",
        "redactedValuePresent"
      ]
    },
    {
      "id": "deploy-vercel-final-candidate",
      "provider": "vercel",
      "action": "redeploy the same exact signed app candidate after the real webhook-secret update without assigning the canonical alias",
      "requiredEvidence": [
        "signedAppCommit",
        "projectId",
        "finalDeploymentId",
        "finalDeploymentUrl",
        "readyAt",
        "webhookSecretUpdatedAt"
      ]
    },
    {
      "id": "retarget-webhook-to-final-deployment",
      "provider": "stripe",
      "action": "update only the existing endpoint URL to the final immutable deployment webhook route",
      "requiredEvidence": [
        "accountId",
        "endpointId",
        "finalEndpointUrl",
        "eventsUnchanged",
        "updatedAt"
      ]
    },
    {
      "id": "probe-deployment-before-alias",
      "provider": "vercel",
      "action": "probe health and invalid Stripe signature on the final immutable deployment URL",
      "requiredEvidence": [
        "finalDeploymentUrl",
        "healthStatus",
        "invalidSignatureStatus",
        "probedAt"
      ]
    },
    {
      "id": "assign-canonical-alias",
      "provider": "vercel",
      "action": "assign only vercelApi.identity.canonicalAlias to the proven deployment",
      "requiredEvidence": [
        "finalDeploymentId",
        "canonicalAlias",
        "aliasAssignedAt",
        "healthStatus"
      ]
    },
    {
      "id": "retarget-webhook-to-canonical-alias",
      "provider": "stripe",
      "action": "update only the existing endpoint URL to stripe.endpoint.url after the canonical alias serves the proven deployment",
      "requiredEvidence": [
        "accountId",
        "endpointId",
        "endpointUrl",
        "eventsUnchanged",
        "updatedAt",
        "canonicalAliasHealthStatus"
      ]
    },
    {
      "id": "activate-canonical-landing-build",
      "provider": "vercel",
      "action": "build and deploy the exact signed landing candidate with only landingBuild.nonSecretVariables",
      "requiredEvidence": [
        "signedLandingCommit",
        "landingDeploymentId",
        "apiBaseValue",
        "approvedOriginOverrideAbsent",
        "readyAt"
      ]
    },
    {
      "id": "run-synthetic-provider-proof",
      "provider": "stripe-convex-vercel",
      "action": "run one synthetic €39 EUR intake, one checkout.session.completed event, and one exact replay",
      "requiredEvidence": [
        "syntheticJobId",
        "checkoutSessionId",
        "endpointId",
        "deliveryId",
        "customerJobCount",
        "fulfillmentJobCount",
        "providerEventCount",
        "generationQueued",
        "replayUnchanged"
      ]
    },
    {
      "id": "install-operator-runtime-secrets",
      "provider": "test-a-review-runtime",
      "action": "install exactly secretStores.resendOperator.allowed through the private runtime secret store before review verification",
      "requiredEvidence": [
        "variableInventory",
        "secretStore",
        "updatedAt",
        "providerCredentialsAbsent",
        "vercelProductionForbiddenVariablesAbsent"
      ]
    },
    {
      "id": "persist-human-approval",
      "provider": "convex",
      "action": "persist qualified human approval for the exact generated revision before publication or delivery",
      "requiredEvidence": [
        "jobId",
        "intakeDigest",
        "runId",
        "revisionDigest",
        "artifactManifestDigest",
        "approvalId",
        "approvedAt",
        "reviewerAuthority"
      ]
    },
    {
      "id": "keep-provider-effects-disabled",
      "provider": "test-a-review-runtime",
      "action": "keep publication and delivery commands disabled until authoritative provider inspection and an independently reviewed re-enable candidate exist",
      "requiredEvidence": [
        "disabledCommandProof",
        "providerCredentialsAbsent",
        "authoritativeInspectionRequirement",
        "localCliVersion"
      ]
    }
  ],
