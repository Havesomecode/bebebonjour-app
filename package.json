{
  "name": "bebebonjour-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "bin": {
    "announce": "./bin/announce.mjs"
  },
  "scripts": {
    "build": "for file in $(find src scripts bin server -type f \\( -name \"*.mjs\" -o -name \"*.js\" \\)); do node --check \"$file\" || exit 1; done",
    "render:r1-bayane": "node scripts/render-r1-fixture.mjs data/examples/bayane/page.json out/r1-bayane",
    "test": "node --test --test-concurrency=4 'test/*.test.mjs' 'test/**/*.test.mjs'",
    "verify": "npm test && npm run build && npm audit --omit=dev",
    "dev:customer-flow": "node ./scripts/local-customer-flow-server.mjs",
    "demo:export": "node ./scripts/export-synthetic-demo.mjs",
    "render:bayane": "node ./bin/announce.mjs render --input data/examples/bayane/page.json --approval data/examples/bayane/approval.json --output out/bayane",
    "render:amal": "node ./bin/announce.mjs render --input data/examples/amal/page.json --approval data/examples/amal/approval.json --output out/amal",
    "compose:bayane": "node ./bin/announce.mjs compose --input data/examples/bayane/intake.json --output out/compose-bayane/page.json --select religious-bayane",
    "start:railway": "node ./server/railway.mjs",
    "test:backend": "node --test test/backend/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@openai/codex": "0.146.0",
    "ajv": "8.20.0",
    "hono": "4.13.7",
    "pg": "8.23.1",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "esbuild": "0.27.0"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "tar": "7.5.22",
    "@fastify/busboy": "3.2.2",
    "ajv": "$ajv",
    "js-yaml": "4.3.2",
    "minimatch@^10.0.0": "10.2.6",
    "path-to-regexp@^6.0.0": "6.3.0",
    "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
    "smol-toml": "1.9.0",
    "undici@<6.28.1": "6.28.1"
  }
}
